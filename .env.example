# --- Supabase (from `supabase start` locally, or Project Settings → API on supabase.com)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI (server-only). Leave the key empty to run with the offline content engine.
# Any OpenAI-compatible API works for text: set OPENAI_BASE_URL + OPENAI_MODEL, e.g.
#   Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai/   model gemini-2.5-flash
#   xAI Grok:      https://api.x.ai/v1                                         model grok-…
#   OpenRouter:    https://openrouter.ai/api/v1                                any listed model
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Text-to-speech / transcription can use a different OpenAI-compatible provider (defaults to the above).
OPENAI_AUDIO_API_KEY=
OPENAI_AUDIO_BASE_URL=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# Second "native editor" pass over generated stories/videos (rewrites anything that sounds
# translated or textbook-like). One extra cheap call per item. Set to false to skip.
AI_NATIVE_REVIEW=true

# --- Quotas
DAILY_AI_MESSAGE_LIMIT=200
DAILY_GENERATION_LIMIT=10
# Generated videos/stories join a shared library and are reused for other learners at the same
# level/genre instead of generating new ones (saves AI cost). Set to false to keep them private.
SHARE_GENERATED_CONTENT=true
