# --- Supabase (from `supabase start` locally, or Project Settings → API on supabase.com)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI (server-only). Leave the key empty to run with the offline content engine.
# Any OpenAI-compatible API works for text: set OPENAI_BASE_URL + OPENAI_MODEL, e.g.
#   Google Gemini: https://generativelanguage.googleapis.com/v1beta/openai/   model gemini-2.5-flash
#   xAI Grok:      https://api.x.ai/v1                                         model grok-…
#   OpenRouter:    https://openrouter.ai/api/v1                                any listed model
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
# Text-to-speech / transcription can use a different OpenAI-compatible provider (defaults to the above).
OPENAI_AUDIO_API_KEY=
OPENAI_AUDIO_BASE_URL=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# Second "native editor" pass over generated stories/videos (rewrites anything that sounds
# translated or textbook-like). One extra cheap call per item. Set to false to skip.
AI_NATIVE_REVIEW=true

# --- Quotas
DAILY_AI_MESSAGE_LIMIT=200
DAILY_GENERATION_LIMIT=10
# New AI videos per learner per day (each costs ~$0.50-0.70 with Grok Imagine). Library reuse is free.
DAILY_VIDEO_GENERATION_LIMIT=3
# Generated videos/stories join a shared library and are reused for other learners at the same
# level/genre instead of generating new ones (saves AI cost). Set to false to keep them private.
SHARE_GENERATED_CONTENT=true

# --- Video generation (optional). When set, video scripts are generated with this provider
# (defaults to xAI Grok). Everything else (stories, chat, TTS, STT) stays on the main OpenAI key.
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4.7
# grok-4.x reasoning effort for scripts (low|medium|high); high is slow
GROK_REASONING_EFFORT=medium

# --- Video visuals (worker). "imagine" generates one Grok Imagine 9:16 clip per scene
# (needs GROK_API_KEY; billed per second of video). Anything else = emoji scene cards (free).
VIDEO_VISUALS=cards
IMAGINE_MODEL=grok-imagine-video-1.5-lite
IMAGINE_RESOLUTION=480p
# "imagine" = characters speak the lines on camera (Grok Imagine audio); otherwise a TTS voice-over
VIDEO_VOICE=imagine
# Text model that writes the per-scene shot prompts (defaults to GROK_MODEL)
IMAGINE_PLANNER_MODEL=
