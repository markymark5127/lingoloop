{
  "name": "lingoloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "worker": "tsx worker/index.ts",
    "worker:hosted": "set -a && . ./.env.hosted && set +a && tsx worker/index.ts",
    "seed": "tsx scripts/seed.ts",
    "seed:hosted": "set -a && . ./.env.hosted && set +a && tsx scripts/seed.ts",
    "starters:hosted": "set -a && . ./.env.hosted && set +a && tsx scripts/generate-starters.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:reset": "supabase db reset && npm run seed && npm run worker -- --once"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "openai": "^7.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  }
}
